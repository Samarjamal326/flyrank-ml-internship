{\n  "cells": [\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": [\n        "# Capstone – Ranking Signal Analysis\n",\n        "\n",\n        "This notebook implements the **Ranking Signal Analysis** lane for the Google Search Ranking & Discoverability capstone. It loads the FlyRank search dataset from Hugging Face, derives a set of safe content signals, evaluates their association with visibility (rank) and clicks, builds a simple gradient‑boosting model, compares against the Week‑4 rule‑based baseline, and exports visualizations and a ranked‑recommendations CSV for the research paper.\n"\n      ]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 1️⃣ Load data from Hugging Face (DuckDB)\n",
        "# ------------------------------------------------------------------\n",
        "import duckdb, pandas as pd, numpy as np, os, json, matplotlib.pyplot as plt\n",
        "\n",
        "# Replace <YOUR_TOKEN> with your HF read token – it should be stored in an env var.\n",
        "hf_token = os.getenv('HF_READ_TOKEN')\n",
        "if not hf_token:\n",
        "    raise RuntimeError('Set HF_READ_TOKEN environment variable with your HuggingFace read token')\n",
        "\n",
        "# Example dataset path – the public repo name is flyrank-ml-internship-data\n",
        "dataset_url = 'hf://datasets/Samarjamal326/flyrank-ml-internship-data'\n",
        "con = duckdb.connect()\n",
        "query = \"SELECT * FROM read_parquet('data/*.parquet')\"  # adjust to actual parquet pattern\n",
        "df = con.execute(query).fetchdf()\n",
        "print('Rows loaded:', len(df))\n"
      ]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 2️⃣ Basic preprocessing (mirroring Week‑4)\n",
        "# ------------------------------------------------------------------\n",
        "# Keep only safe columns – no private identifiers\n",
        "safe_cols = [\n",
        "    'content_id', 'impressions_90d', 'clicks_90d', 'ctr_90d',\n",
        "    'freshness_score', 'authority_score', 'keyword_group', 'publish_date'\n",
        "]\n",
        "df = df[safe_cols].copy()\n",
        "# Create label: top‑10% rank by impressions considered "high visibility"\n",
        "df['visibility_rank'] = df['impressions_90d'].rank(method='first', ascending=False)\n",
        "threshold = np.percentile(df['visibility_rank'], 10)\n",
        "df['high_vis'] = (df['visibility_rank'] <= threshold).astype(int)\n",
        "# Simple feature engineering\n",
        "df['log_impr'] = np.log1p(df['impressions_90d'])\n",
        "df['log_clicks'] = np.log1p(df['clicks_90d'])\n",
        "df['log_ctr'] = np.log1p(df['ctr_90d'] + 1e-6)\n",
        "# Encode keyword_group (few categories)\n",
        "df = pd.get_dummies(df, columns=['keyword_group'], drop_first=True)\n",
        "# Split – honest 70/30 hold‑out matching baseline\n",
        "from sklearn.model_selection import train_test_split\n",
        "X = df.drop(columns=['high_vis', 'visibility_rank'])\n",
        "y = df['high_vis']\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.30, random_state=42, stratify=y)\n"
      ]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 3️⃣ Model – Gradient Boosting (XGBoost style, using sklearn's HistGradientBoosting)\n",
        "# ------------------------------------------------------------------\n",
        "from sklearn.experimental import enable_hist_gradient_boosting  # noqa\n",
        "from sklearn.ensemble import HistGradientBoostingClassifier\n",
        "\n",
        "model = HistGradientBoostingClassifier(max_depth=6, learning_rate=0.1, random_state=42)\n",
        "model.fit(X_train, y_train)\n",
        "# Predict probabilities for test set\n",
        "test_probs = model.predict_proba(X_test)[:, 1]\n"
      ]\n    },\n    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 4️⃣ Baseline – reuse Week‑4 rule (impressions_90d > median)\n",
        "# ------------------------------------------------------------------\n",
        "baseline_threshold = df['impressions_90d'].median()\n",
        "baseline_pred = (X_test['impressions_90d'] > baseline_threshold).astype(int)\n",
        "# For ranking metrics we keep scores – use raw impressions as score\n",
        "baseline_scores = X_test['impressions_90d'].values\n"
      ]
    },
    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 5️⃣ Evaluation – Precision@20 & @50 (same as Week‑4)\n",
        "# ------------------------------------------------------------------\n",
        "def precision_at_k(y_true, scores, k):\n",
        "    order = np.argsort(-scores)\n",
        "    top_k = order[:k]\n",
        "    return np.mean(y_true[top_k])\n",
        "\n",
        "k_vals = [20, 50]\n",
        "metrics = []\n",
        "for k in k_vals:\n",
        "    model_prec = precision_at_k(y_test.values, test_probs, k)\n",
        "    base_prec = precision_at_k(y_test.values, baseline_scores, k)\n",
        "    metrics.append({'k': k, 'model': model_prec, 'baseline': base_prec})\n",
        "\n",
        "import pandas as pd\n",
        "metrics_df = pd.DataFrame(metrics)\n",
        "display(metrics_df)\n"
      ]
    },
    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 6️⃣ Feature importance (SHAP style) – we use built‑in importance\n",
        "# ------------------------------------------------------------------\n",
        "importances = model.feature_importances_\n",
        "feat_names = X_train.columns\n",
        "imp_df = pd.Series(importances, index=feat_names).sort_values(ascending=False)\n",
        "imp_df.head(10).plot.barh(figsize=(6,4))\n",
        "plt.gca().invert_yaxis()\n",
        "plt.title('Top 10 Feature Importances')\n",
        "plt.tight_layout()\n",
        "plt.savefig('paper/assets/feature_importance.png')\n",
        "plt.show()\n"
      ]
    },
    {\n      "cell_type": "code",\n      "execution_count": null,\n      "metadata": {},\n      "outputs": [],\n      "source": [\n        "# ------------------------------------------------------------------\n",
        "# 7️⃣ Generate ranked recommendations – highest‑probability unseen content\n",
        "# ------------------------------------------------------------------\n",
        "test_df = X_test.copy()\n",
        "test_df['content_id'] = df.loc[X_test.index, 'content_id']\n",
        "test_df['model_score'] = test_probs\n",
        "test_df.sort_values('model_score', ascending=False, inplace=True)\n",
        "top_n = test_df.head(20)[['content_id', 'model_score']].reset_index(drop=True)\n",
        "top_n.to_csv('paper/assets/recommendations.csv', index=False)\n",
        "top_n.head(10).to_markdown('paper/assets/recommendations.md')\n"
      ]
    },\n    {\n      "cell_type": "markdown",\n      "metadata": {},\n      "source": [\n        "## 8️⃣ Export artifacts for the paper\n",
        "* `paper/assets/feature_importance.png` – top‑10 feature importance chart\n",
        "* `paper/assets/recommendations.csv` – ranked list of content IDs to act on\n",
        "* `metrics_df` table will be copied into the paper markdown section.\n"
      ]\n    }
  ],\n  "metadata": {\n    "kernelspec": {\n      "display_name": "Python 3",\n      "name": "python3"\n    },\n    "language_info": {\n      "name": "python",\n      "version": "3.11"\n    }\n  },\n  "nbformat": 4,\n  "nbformat_minor": 5\n}\n
